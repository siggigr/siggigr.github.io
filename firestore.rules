rules_version = '2';

// Least-privilege model:
//   - All site content is publicly readable (it is a public website).
//   - Writes are only allowed for accounts listed in the `admins` collection.
//   - The `admins` collection itself can NEVER be written from the client;
//     admin accounts are added manually in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist. Read: only your own entry (so the app can check
    // whether the signed-in user is an admin). Write: console only.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Singleton text blocks (hero, about, professional).
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /family/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /interests/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
